{
  "name": "@app/evals",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy:prepare": "pnpm --filter @app/sandbox build",
    "deploy": "pnpm run deploy:prepare && wrangler deploy",
    "deploy:dry-run": "pnpm run deploy:prepare && wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "test": "vitest run --maxWorkers=2",
    "report": "tsx scripts/report.ts",
    "gates": "tsx scripts/gates.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.2.0",
    "zod": "^4.6.5"
  }
}
