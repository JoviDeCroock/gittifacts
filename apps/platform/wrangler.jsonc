{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // The whole platform is one Worker: API, MCP, web UI (static assets), Durable Objects, Workflows.
  "name": "gittifacts",
  "main": "./src/index.ts",
  // Latest date supported by workerd 1.20260930.x (docs/research/stack.md §5).
  "compatibility_date": "2026-09-30",
  // nodejs_compat is required by better-auth (node:crypto scrypt), not just nodejs_als.
  "compatibility_flags": ["nodejs_compat"],

  // Workers Logs + Workers Issues. Keep `issues.enabled` set: a deploy without it turns Issues off.
  "observability": {
    "enabled": true,
    "logs": { "enabled": true },
    "issues": { "enabled": true }
  },

  "vars": {
    // `workflows` (WorkflowsCiEngine, default) or `cloudflare-ci` (opt-in, separate env; DECISIONS.md).
    "CI_ENGINE": "workflows",
    // Salt for CI cache keys (bump to invalidate every cached snapshot pointer).
    "CI_CACHE_NAMESPACE": "v1",
    "ARTIFACTS_NAMESPACE": "gittifacts-eu",
    "AI_GATEWAY_ID": "gittifacts",
    "FLAGSHIP_APP_ID": "a829ecb3-7b1d-4640-9117-77d6fff4ca5d",
    // Not a secret: Artifacts remotes and the REST APIs (Versions, Flagship, Observability) need it.
    "CF_ACCOUNT_ID": "c8a74ade336909a754b36a7379edca30",
    // Change previews: p-<changeId>[-<sha8>]<PREVIEW_HOST_SUFFIX> is served by the preview gateway in
    // this Worker (src/previews/gateway.ts) from a PreviewHost container. See `routes` below.
    "PREVIEW_HOST_SUFFIX": "-pv.resynapse.dev",
    // Analytics Engine dataset METRICS writes to (the time-to-first-green dashboard queries it).
    "METRICS_DATASET": "gittifacts_metrics",
    // Unclaimed projects (O3): deleted this many days after creation unless a human claims them.
    // Every other unclaimed limit has a default in src/limits/config.ts; override any subset with
    // an `UNCLAIMED_LIMITS` JSON var. Optional, set outside this file: TURNSTILE_SITE_KEY (var)
    // and TURNSTILE_SECRET_KEY (secret) for the claim page (unset: Cloudflare's test keys), and
    // PLATFORM_ADMINS (comma-separated principal ids, hu_…) for the kill-switch override endpoint.
    "UNCLAIMED_TTL_DAYS": "7",
    // Public Turnstile site key of the `gittifacts-claim` widget (the secret is a Worker secret).
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFLsOe8gJedT53qK",
    // Humans allowed to flip the unclaimed-creation kill-switch override (comma-separated hu_… ids).
    "PLATFORM_ADMINS": "hu_3XXFXEuxAyAwrnKdYWRWYkV1KhFKfy9A",
    // Merge queue deploy trains (docs/prompts/03-merge-queue.md §4.8): merged Changes deploy in
    // per-Worker trains with flag-first attribution. "off" = one RolloutWorkflow per Change.
    "MERGE_QUEUE_TRAINS": "on"
  },

  // The preview gateway: every *-pv.resynapse.dev request reaches this Worker. Previews are
  // first-level subdomains so Universal SSL covers them (DNS: proxied *.resynapse.dev AAAA 100::;
  // the route only matches the -pv suffix, so the zone's other subdomains are untouched). workers.dev stays on for the platform itself.
  "workers_dev": true,
  "routes": [{ "pattern": "*-pv.resynapse.dev/*", "zone_name": "resynapse.dev" }],

  // `wrangler types` reads this list; values live in `.dev.vars` locally (see .dev.vars.example)
  // and in `wrangler secret put` remotely.
  // Required to run at all. Optional secrets (feature degrades with a clear error when absent):
  // GITHUB_CLIENT_ID / GITHUB_CLIENT_SECRET (GitHub sign-in), CF_API_TOKEN (rollouts, flags, telemetry).
  "secrets": {
    "required": ["PLATFORM_SIGNING_KEY", "BETTER_AUTH_SECRET", "ISSUES_WEBHOOK_SECRET"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gittifacts",
      // EU jurisdiction (docs/deploy.md).
      "database_id": "832e640d-ef87-482c-a20e-b0aa2df1e065",
      "migrations_dir": "migrations"
    }
  ],

  // Large diffs/evidence (> 512 KB), CI logs, screenshots, build cache pointers.
  // CI_BUCKET is the CI engine's view of the same bucket: its keys (ci-runs/, ci-logs/,
  // ci-evidence/, ci-artifacts/, ci-cache/) are what `GET /api/v1/blobs/:ref` serves through BLOBS.
  "r2_buckets": [
    { "binding": "BLOBS", "bucket_name": "gittifacts-blobs", "jurisdiction": "eu" },
    { "binding": "CI_BUCKET", "bucket_name": "gittifacts-blobs", "jurisdiction": "eu" }
  ],

  // Artifacts has no local simulator; the binding always talks to the remote service.
  "artifacts": [{ "binding": "ARTIFACTS", "namespace": "gittifacts-eu", "remote": true }],

  // Per-change kill-switch flags (app gittifacts-changes). The binding evaluates; writes go through REST.
  "flagship": [{ "binding": "FLAGS", "app_id": "a829ecb3-7b1d-4640-9117-77d6fff4ca5d" }],

  "ai": { "binding": "AI", "remote": true },
  "browser": { "binding": "BROWSER" },
  "analytics_engine_datasets": [{ "binding": "METRICS", "dataset": "gittifacts_metrics" }],
  "version_metadata": { "binding": "VERSION" },

  // Option A from stack.md §5: packages/web builds with Vite into ../../packages/web/dist.
  // run_worker_first: true. The same Worker serves the preview gateway on
  // *.preview.resynapse.dev, whose paths must never be answered from the platform's own assets
  // (a preview's /about/ is not the SPA). Patterns are path-only, so every request runs the
  // Worker first; platform hosts fall back to ASSETS (src/app.ts notFound), and the front door
  // (/, /start, /llms.txt, /openapi.json, /mcp/server-card) is Worker-owned anyway.
  "assets": {
    "directory": "../../packages/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },

  "durable_objects": {
    "bindings": [
      // One AuditLog per org; the platform uses the name "global" for now.
      { "name": "AUDIT_LOG", "class_name": "AuditLog" },
      // One per change (addressed by change id). Also the CI engine's run sink: CiRunWorkflow calls
      // env.COORDINATOR.getByName(changeId).onRunFinished(summary).
      { "name": "COORDINATOR", "class_name": "ChangeCoordinator" },
      // One per repo: the only writer of a repo's default branch.
      { "name": "MERGE_QUEUE", "class_name": "MergeQueue" },
      // One per CI step / sandbox job; drives ctx.container (the sandbox image).
      { "name": "RUNNER", "class_name": "Runner" },
      // One per pinned preview (p-<changeId>-<sha8>): the change's built Worker under workerd in
      // its own container (same sandbox image), started from the CI build snapshot.
      { "name": "PREVIEW_HOST", "class_name": "PreviewHost" },
      // One per Change workspace (ws-<changeId>): a remote sandbox with the Change's fork checked
      // out, for agents without a shell (open_workspace / ws_*). Its own container app.
      { "name": "WORKSPACE", "class_name": "Workspace" },
      // One per project (repo id): workspace quota (vCPU-seconds/day), open workspaces, and the
      // latest .platform proposal of an import. Also the unclaimed-project quotas (CI minutes,
      // storage, Artifacts operations), and their per-IP aggregates under `ip:<hash>`.
      { "name": "PROJECT_LEDGER", "class_name": "ProjectLedger" },
      // Token buckets for credential-less create_project: one per `ip:<hash>`, `asn:<n>` and
      // `global` (long windows and one global counter, which the rate-limit binding can't do).
      { "name": "ABUSE_LIMITER", "class_name": "AbuseLimiter" }
    ]
  },

  // Per-token request limit for unclaimed projects' tokens (src/limits/request-limit.ts). The
  // namespace id is ours to choose (no resource to create); keep it unique within the account.
  "ratelimits": [
    { "name": "UNCLAIMED_TOKEN_LIMITER", "namespace_id": "4301", "simple": { "limit": 120, "period": 60 } },
    // One request budget per external integration (all its installations), API + /git/ proxy
    // (src/integrations/auth.ts). Namespace id is ours to choose; nothing to create.
    { "name": "INTEGRATION_LIMITER", "namespace_id": "4302", "simple": { "limit": 600, "period": 60 } }
  ],

  // Integration webhooks (src/integrations/delivery.ts): one message per delivery, at least once.
  // The consumer retries with its own backoff (msg.retry delaySeconds); after max_retries a message
  // goes to the dead-letter queue (the delivery row already says `failed` by then).
  // Create once: `wrangler queues create gittifacts-webhooks` and `… gittifacts-webhooks-dlq`.
  "queues": {
    "producers": [{ "binding": "WEBHOOK_QUEUE", "queue": "gittifacts-webhooks" }],
    "consumers": [
      {
        "queue": "gittifacts-webhooks",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 10,
        "dead_letter_queue": "gittifacts-webhooks-dlq"
      }
    ]
  },

  // Declarative exports (SQLite DOs). Mutually exclusive with `migrations`. CiEgressGateway is the
  // WorkerEntrypoint the Runner reaches through ctx.exports for `network: "registries-only"`.
  "exports": {
    "AuditLog": { "type": "durable-object", "storage": "sqlite" },
    "ChangeCoordinator": { "type": "durable-object", "storage": "sqlite" },
    "MergeQueue": { "type": "durable-object", "storage": "sqlite" },
    "Runner": { "type": "durable-object", "storage": "sqlite", "container": "runner" },
    "PreviewHost": { "type": "durable-object", "storage": "sqlite", "container": "preview" },
    "CiEgressGateway": { "type": "worker" },
    "Workspace": { "type": "durable-object", "storage": "sqlite", "container": "workspace" },
    "ProjectLedger": { "type": "durable-object", "storage": "sqlite" },
    "AbuseLimiter": { "type": "durable-object", "storage": "sqlite" },
    // registries-only egress for workspaces: the CI policy plus `git push` to the own fork.
    "WorkspaceEgressGateway": { "type": "worker" }
  },

  // compute.md §3.1. The durable_object policy rejects image / instance_type / max_instances: the
  // Runner picks `images.base` and the instance type at runtime in start(). Build the runner bundle
  // first (`pnpm --filter @app/sandbox build`; the deploy script does it).
  "containers": [
    {
      "name": "runner",
      "class_name": "Runner",
      "scheduling_policy": "durable_object",
      "images": {
        "base": { "dockerfile": "../sandbox/Dockerfile", "build_context": "../sandbox" }
      },
      "observability": { "logs": { "enabled": true } }
    },
    // A container can back only one Durable Object class (wrangler), so previews get their own
    // application on the same image. Previews start from the Runner's build snapshots, which
    // needs both applications to resolve to the same image digest (same Dockerfile and context,
    // pushed "if changed"); when a restore fails the preview is reported as an error.
    {
      "name": "preview",
      "class_name": "PreviewHost",
      "scheduling_policy": "durable_object",
      "images": {
        "base": { "dockerfile": "../sandbox/Dockerfile", "build_context": "../sandbox" }
      },
      "observability": { "logs": { "enabled": true } }
    },
    // Remote workspaces: same image again (one container app per DO class). They restore the
    // Runner's install snapshots when the digests match, else fall back to the image.
    {
      "name": "workspace",
      "class_name": "Workspace",
      "scheduling_policy": "durable_object",
      "images": {
        "base": { "dockerfile": "../sandbox/Dockerfile", "build_context": "../sandbox" }
      },
      "observability": { "logs": { "enabled": true } }
    }
  ],

  // compute.md §2. Workflows stay in this array (not `exports`): vitest introspection needs a binding.
  "workflows": [
    // One per (change, head): diff → policy → CI → evidence → classify → tour → route → merge.
    { "name": "change-workflow", "binding": "CHANGE_WORKFLOW", "class_name": "ChangeWorkflow" },
    // One per merged change with a deploy target: gradual rollout, watch, auto-revert.
    { "name": "rollout-workflow", "binding": "ROLLOUT_WORKFLOW", "class_name": "RolloutWorkflow" },
    // One per Artifacts push in the namespace (triggers.events below).
    { "name": "push-router", "binding": "PUSH_ROUTER", "class_name": "PushRouter" },
    // One per CI run (instance id = runId = PipelineRun.id).
    { "name": "ci-run-workflow", "binding": "CI_RUN_WORKFLOW", "class_name": "CiRunWorkflow" },
    // One per merge-queue batch run / flake re-check (mq-<repoId>-<epoch>-<runId>): CI on the
    // batch's refs/queue/<batchId> commit in the main repo, fail fast, result to the MergeQueue DO.
    { "name": "batch-run-workflow", "binding": "BATCH_RUN_WORKFLOW", "class_name": "BatchRunWorkflow" },
    // One per import proposal (pcfg-<repoId>-<sha12>-<n>): detect → draft Plan → Change with the
    // proposed .platform/* + AGENTS.md pushed to its fork (a human approves; Lane 2).
    {
      "name": "platform-config-workflow",
      "binding": "PLATFORM_CONFIG_WORKFLOW",
      "class_name": "PlatformConfigWorkflow"
    }
  ],

  // Every push in the namespace starts one PushRouter instance (artifacts.md §1, §6). The target
  // Workflow must be defined by this Worker.
  "triggers": {
    // Expire unclaimed projects whose TTL ran out (src/claim/expire.ts).
    "crons": ["*/10 * * * *"],
    "events": [
      {
        "type": "cf.artifacts.repo.pushed",
        "filter": { "namespace": "gittifacts-eu" },
        "targets": [{ "type": "workflow", "workflow_name": "push-router" }]
      }
    ]
  }
}
