{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Workers types only: the Worker's code (and the @app/* sources it bundles) must type-check
    // against the runtime it runs on. vitest.config.ts / drizzle.config.ts use tsconfig.node.json.
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-plugin/types"],
    "lib": ["ES2023"],
    "declaration": false
  },
  "include": ["src", "test", "worker-configuration.d.ts"],
  "exclude": ["src/auth.cli.ts"]
}
