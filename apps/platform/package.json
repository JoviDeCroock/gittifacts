{
  "name": "@app/platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "pnpm --filter @app/web build && wrangler deploy",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@app/ci-engine": "workspace:*",
    "@app/classifier": "workspace:*",
    "@app/coordinator": "workspace:*",
    "@app/domain": "workspace:*",
    "@app/evidence": "workspace:*",
    "@app/gitwire": "workspace:*",
    "@app/mcp": "workspace:*",
    "@app/tour": "workspace:*",
    "@better-auth/api-key": "1.7.7",
    "@better-auth/passkey": "1.7.7",
    "@hono/zod-openapi": "1.6.3",
    "@modelcontextprotocol/server": "2.2.0",
    "better-auth": "1.7.7",
    "drizzle-orm": "0.45.3",
    "hono": "4.13.12",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "auth": "1.7.7",
    "drizzle-kit": "0.31.11"
  }
}
