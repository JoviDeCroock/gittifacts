# Applies to either build context (repository root or apps/sandbox; see the Dockerfile).
# BuildKit reads <Dockerfile>.dockerignore instead of a .dockerignore at the context root.
# Only the prebuilt bundle, its runtime manifest and image/ are sent.
**
!apps/sandbox/dist/gittifacts-runner.mjs
!apps/sandbox/dist/package.json
!apps/sandbox/image/**
!dist/gittifacts-runner.mjs
!dist/package.json
!image/**
